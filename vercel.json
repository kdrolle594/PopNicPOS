{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'API only - frontend deploys to GitHub Pages'",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
